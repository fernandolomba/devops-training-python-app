def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

def appImage

pipeline {
    agent any
    
    parameters {
        booleanParam(name: 'RUN_CD', defaultValue: false, description: '¿Ejecutar despliegue CD?')
    }

    stages {
        stage('Build CI Image') {
            steps {
                sh 'docker build -t mi-app-ci -f devops/ci.Dockerfile .'
            }
        }
        stage('Lint') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make lint'
                    }
                }
            }
        }
        stage('Test') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make test'
                    }
                }
            }
        }
        stage('Build Production Image') {
            steps {
                script {
                    appImage = docker.build("contrerasadr/devops-training-python-app:0.0.1", "-f Dockerfile .")
                }
            }
        }
        
        stage('CD') {
            when {
                anyOf {
                    expression { return params.RUN_CD == true }
                    branch 'develop'
                    branch 'master'
                }
            }
            steps {
                script {
                    echo "Limpieza y despliegue: branch=${env.BRANCH_NAME}"
                    try {
                        // Borrado  de los contenedores conflictivos por nombre
                        // Usamos || true para que si el contenedor no existe, el pipeline no falle
                        sh 'docker rm -f my-flask-app-db my-flask-app-dc || true'
                        
                        // Limpieza normal de compose
                        sh 'docker compose down --volumes --remove-orphans'
                        
                        // Levantar el entorno
                        sh 'docker compose up -d'
                        
                        sleep 5
                        sh 'docker compose logs app'
                    } finally {
                        // Opcional: limpiar al final
                        sh 'docker compose down --volumes --remove-orphans'
                    }
                }
            }
        }
    }
}
