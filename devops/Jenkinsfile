pipeline {
    agent any

    stages {
        stage('Build CI Image') {
            steps {
                // Construimos la imagen con make disponible
                sh 'docker build -t mi-app-ci -f devops/ci.Dockerfile .'
            }
        }

        stage('Install Dependencies') {
            agent {
                docker {
                    image 'mi-app-ci'
                    reuseNode true
                }
            }
            steps {
                // Instalamos TODO lo que el Makefile necesita (incluyendo linters y test tools)
                sh 'pip install -r requirements.txt flake8 mypy black coverage pytest'
            }
        }

        stage('Lint') {
            agent {
                docker {
                    image 'mi-app-ci'
                    reuseNode true
                }
            }
            steps {
                // Ahora ENV_PREFIX estará vacío y ejecutará "flake8 src/", etc.
                sh 'make lint'
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'mi-app-ci'
                    reuseNode true
                }
            }
            steps {
                // Ejecuta los tests a través del Makefile
                sh 'make test'
            }
        }
    }
}
