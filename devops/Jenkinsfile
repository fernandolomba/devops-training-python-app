def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

def appImage

pipeline {
    agent any

    stages {
        stage('Build CI Image') {
            steps {
                sh 'docker build -t mi-app-ci -f devops/ci.Dockerfile .'
            }
        }
        stage('Lint') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make lint'
                    }
                }
            }
        }
        stage('Test') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make test'
                    }
                }
            }
        }
        stage('Build Image') {
            steps {
                script {
                    appImage = docker.build('mi-app', '-f devops/Dockerfile .')
                }
            }
        }

        stage('CD') {
            // Se ejecuta SOLO si la rama actual es develop o master
            when {
                anyOf {
                    branch 'develop'
                    branch 'master'
                }
            }
            steps {
                script {
                    echo "Ejecutando CD en la rama: ${env.BRANCH_NAME}"
                    try {
                        sh 'docker compose up -d'
                        sleep 5
                        sh 'docker compose logs app'
                    } finally {
                        sh 'docker compose down --volumes'
                    }
                }
            }
        }
    }
}
