def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

pipeline {
    agent any
    
    // --- Tarea: Definición del parámetro RUN_CD ---
    parameters {
        booleanParam(
            name: 'RUN_CD', 
            defaultValue: false, 
            description: 'Si se marca, ejecutará el stage CD en cualquier rama. Si no, solo en develop/master.'
        )
    }

    stages {
        stage('Build CI Image') {
            steps {
                sh 'docker build -t mi-app-ci -f devops/ci.Dockerfile .'
            }
        }
        
        stage('Lint & Test') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make lint'
                        sh 'make test'
                    }
                }
            }
        }

        stage('Build Production Image') {
            steps {
                script {
                    docker.build("contrerasadr/devops-training-python-app:0.0.1", "-f Dockerfile .")
                }
            }
        }
        
        // --- Tarea: Stage CD con lógica condicional avanzada ---
        stage('CD') {
            when {
                anyOf {
                    // Condición 1: El usuario activó el check manualmente
                    expression { return params.RUN_CD } 
                    
                    // Condición 2: Estamos en las ramas principales
                    branch 'develop'
                    branch 'master'
                }
            }
            steps {
                script {
                    // Pintamos el entorno (Ejercicio 6.2) y el estado del parámetro
                    env.DEPLOY_ENV = (env.BRANCH_NAME == 'master') ? 'PRO' : 'DEV'
                    echo "CD habilitado: RUN_CD=${params.RUN_CD}, branch=${env.BRANCH_NAME}"
                    echo "Deploying to ${env.DEPLOY_ENV}"
                    
                    def projectName = env.DEPLOY_ENV.toLowerCase()
                    
                    try {
                        sh "docker compose -p ${projectName} down --volumes --remove-orphans"
                        sh "docker compose -p ${projectName} up -d"
                        sleep 5
                        sh "docker compose -p ${projectName} logs app"
                    } finally {
                        sh "docker compose -p ${projectName} down --volumes --remove-orphans"
                    }
                }
            }
        }
    }
}
