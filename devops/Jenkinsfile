def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

def appImage

pipeline {
    agent any
    
    parameters {
        booleanParam(name: 'RUN_CD', defaultValue: false, description: '¿Ejecutar despliegue CD?')
    }

    stages {
        stage('Build CI Image') {
            steps {
                sh 'docker build -t mi-app-ci -f devops/ci.Dockerfile .'
            }
        }
        stage('Lint') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make lint'
                    }
                }
            }
        }
        stage('Test') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make test'
                    }
                }
            }
        }
        stage('Build Production Image') {
            steps {
                script {
                    appImage = docker.build("contrerasadr/devops-training-python-app:0.0.1", "-f Dockerfile .")
                }
            }
        }
        
        stage('CD') {
            when {
                anyOf {
                    expression { return params.RUN_CD == true }
                    branch 'develop'
                    branch 'master'
                }
            }
            steps {
                script {
                    echo "CD habilitado: RUN_CD=${params.RUN_CD}, branch=${env.BRANCH_NAME}"
                    try {
                        // Limpieza de contenedores huérfanos o con nombres duplicados
                        sh 'docker compose down --volumes --remove-orphans'
                        
                        sh 'docker compose up -d'
                        sleep 10
                        sh 'docker compose logs app'
                    } finally {
                        // Borra la app al terminar el stage. 
                        // sh 'docker compose down --volumes --remove-orphans'
                    }
                }
            }
        }
    }
}
