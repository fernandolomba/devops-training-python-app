def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

def appImage

pipeline {
    agent any

    stages {
        stage('Build CI Image') {
            steps {
                // Esta es la imagen con herramientas (make, linters, etc.)
                sh 'docker build -t mi-app-ci -f devops/ci.Dockerfile .'
            }
        }

        stage('Lint') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make lint'
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make test'
                    }
                }
            }
        }

        stage('Build Production Image') {
            steps {
                script {
                    // Importante: El nombre debe coincidir con el de tu docker-compose.yml
                    // para evitar el error "pull access denied"
                    appImage = docker.build("contrerasadr/devops-training-python-app:0.0.1", "-f devops/Dockerfile .")
                }
            }
        }
        
        stage('CD') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'master'
                }
            }
            steps {
                script {
                    echo "Desplegando rama: ${env.BRANCH_NAME}"
                    try {
                        sh 'docker compose up -d'
                        sleep 5
                        sh 'docker compose logs app'
                    } finally {
                        sh 'docker compose down --volumes'
                    }
                }
            }
        }
    }
}
