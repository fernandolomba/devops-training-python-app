def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

def appImage

pipeline {
    agent any

    environment {
        // Usamos el número de build para que la imagen sea única
        IMAGE_NAME = "contrerasadr/devops-training-python-app:${env.BUILD_NUMBER}"
        APP_URL    = "http://localhost:5001/"
    }
    
    parameters {
        booleanParam(name: 'RUN_CD', defaultValue: false, description: 'Ejecutar CD manualmente')
    }

    stages {
        stage('Build CI Image') {
            steps {
                sh 'docker build -t mi-app-ci -f devops/ci.Dockerfile .'
            }
        }
        
        stage('Lint') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make lint'
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    runInDocker('mi-app-ci') {
                        sh 'make test'
                    }
                }
            }
        }

        stage('Build Image') {
            steps {
                script {
                    echo "Construyendo imagen: ${env.IMAGE_NAME}"
                    appImage = docker.build("${env.IMAGE_NAME}", "-f Dockerfile .")
                }
            }
        }
        
        stage('CD') {
            when {
                anyOf {
                    expression { return params.RUN_CD }
                    branch 'develop'
                    branch 'master'
                }
            }
            steps {
                script {
                    env.DEPLOY_ENV = (env.BRANCH_NAME == 'master') ? 'PRO' : 'DEV'
                    def projectName = env.DEPLOY_ENV.toLowerCase()
                    
                    echo "Iniciando despliegue en entorno: ${env.DEPLOY_ENV}"
                    
                    // Limpieza de contenedores conflictivos
                    sh "docker rm -f my-flask-app-db my-flask-app-dc || true"
                    
                    // Levantamos con la imagen específica del build
                    withEnv(["IMAGE_NAME=${env.IMAGE_NAME}"]) {
                        sh "docker compose -p ${projectName} up -d"
                    }
                    
                    sleep 5
                    echo "Validando despliegue en: ${env.APP_URL}"
                }
            }
            // Tarea 6.5: Post hooks específicos para el stage CD
            post {
                always {
                    script {
                        def projectName = (env.BRANCH_NAME == 'master' ? 'pro' : 'dev')
                        echo "Limpiando recursos del proyecto: ${projectName}"
                        sh "docker compose -p ${projectName} down --volumes --remove-orphans || true"
                    }
                }
                success {
                    echo "SUCCESS: El despliegue en ${env.DEPLOY_ENV} se ha completado correctamente."
                }
                failure {
                    script {
                        def projectName = (env.BRANCH_NAME == 'master' ? 'pro' : 'dev')
                        echo "FAILURE: Error en el despliegue de ${env.DEPLOY_ENV}. Extrayendo logs..."
                        sh "docker compose -p ${projectName} logs || true"
                    }
                }
            }
        }
    }

    // Tarea 6.5: Post hook global para limpieza de imágenes 
    post {
        always {
            echo "Finalizando pipeline. Limpiando imágenes temporales..."
            sh "docker rmi ${env.IMAGE_NAME} || true"
        }
    }
}
